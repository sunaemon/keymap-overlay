<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <title>keymap-overlay third-party licenses</title>
  </head>
  <body>
    <h1>keymap-overlay third-party licenses</h1>
    <p>This document lists the licenses of dependencies distributed with
      keymap-overlay.</p>
    <p>The self-contained Windows executable redistributes the .NET runtime and
      WPF under Microsoft's .NET Library License and their applicable
      third-party terms. The Windows release archive includes
      <code>DOTNET-LIBRARY-LICENSE.txt</code>
      plus versioned
      <code>dotnet-runtime-*-THIRD-PARTY-NOTICES.txt</code>
      and
      <code>dotnet-wpf-*-THIRD-PARTY-NOTICES.txt</code>
      files. Their source is published by Microsoft in the
      <a href='https://github.com/dotnet/runtime'>dotnet/runtime</a>
      and
      <a href='https://github.com/dotnet/wpf'>dotnet/wpf</a>
      repositories.</p>
    {{#each licenses}}
      {{#if first_of_kind}}
        <h2 id='{{id}}'>{{name}}</h2>
      {{/if}}
      <h3>{{name}}</h3>
      <p>Used by:</p>
      <ul>
        {{#each used_by}}
          <li>{{crate.name}}
            {{crate.version}}{{#if crate.repository}}
              —
              <a href='{{crate.repository}}'>source</a>{{/if}}</li>
        {{/each}}
      </ul>
      <pre>{{text}}</pre>
    {{/each}}
  </body>
</html>